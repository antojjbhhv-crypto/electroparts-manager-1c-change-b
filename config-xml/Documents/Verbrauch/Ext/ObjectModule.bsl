Процедура ОбработкаПроведения(Отказ, РежимПроведения)
	
	Блокировка = Новый БлокировкаДанных;
	ЭлементБлокировки = Блокировка.Добавить("РегистрНакопления.Bestaende");
	ЭлементБлокировки.Режим = РежимБлокировкиДанных.Исключительный;
	Блокировка.Заблокировать();
	
	СуммыПоКомпонентам = Новый Соответствие;
	
	Для Каждого СтрокаТЧ Из Komponenten Цикл
		
		Если Не ЗначениеЗаполнено(СтрокаТЧ.Komponente) Тогда
			Отказ = Истина;
			Сообщить("Komponente fehlt. Zeile " + СтрокаТЧ.НомерСтроки);
			Продолжить;
		КонецЕсли;
		
		Если СтрокаТЧ.Menge <= 0 Тогда
			Отказ = Истина;
			Сообщить("Menge muss positiv sein. Zeile " + СтрокаТЧ.НомерСтроки);
			Продолжить;
		КонецЕсли;
		
		ПредыдущаяСумма = СуммыПоКомпонентам[СтрокаТЧ.Komponente];
		Если ПредыдущаяСумма = Неопределено Тогда
			СуммыПоКомпонентам[СтрокаТЧ.Komponente] = СтрокаТЧ.Menge;
		Иначе
			СуммыПоКомпонентам[СтрокаТЧ.Komponente] = ПредыдущаяСумма + СтрокаТЧ.Menge;
		КонецЕсли;
		
	КонецЦикла;
	
	Если Отказ Тогда
		Возврат;
	КонецЕсли;
	
	Если СуммыПоКомпонентам.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	СписокКомпонентов = Новый СписокЗначений;
	Для Каждого КлючИЗначение Из СуммыПоКомпонентам Цикл
		СписокКомпонентов.Добавить(КлючИЗначение.Ключ);
	КонецЦикла;
	
	ЗапросКомпонентов = Новый Запрос;
	ЗапросКомпонентов.УстановитьПараметр("Компоненты", СписокКомпонентов);
	ЗапросКомпонентов.Текст =
	"ВЫБРАТЬ
	|	Komponenten.Ссылка КАК Komponente,
	|	Komponenten.Artikel КАК Artikel,
	|	Komponenten.Наименование КАК Name,
	|	Komponenten.Einheit КАК Einheit,
	|	Komponenten.Mindestbestand КАК Mindestbestand
	|ИЗ
	|	Справочник.Komponenten КАК Komponenten
	|ГДЕ
	|	Komponenten.Ссылка В (&Компоненты)";
	
	ВыборкаКомпонентов = ЗапросКомпонентов.Выполнить().Выбрать();
	СведенияОКомпонентах = Новый Соответствие;
	Пока ВыборкаКомпонентов.Следующий() Цикл
		Сведения = Новый Структура("Artikel, Name, Einheit, Mindestbestand");
		Сведения.Artikel = ВыборкаКомпонентов.Artikel;
		Сведения.Name = ВыборкаКомпонентов.Name;
		Сведения.Einheit = ВыборкаКомпонентов.Einheit;
		Сведения.Mindestbestand = ВыборкаКомпонентов.Mindestbestand;
		СведенияОКомпонентах[ВыборкаКомпонентов.Komponente] = Сведения;
	КонецЦикла;
	
	ЗапросОстатки = Новый Запрос;
	ЗапросОстатки.УстановитьПараметр("Компоненты", СписокКомпонентов);
	ЗапросОстатки.УстановитьПараметр("ДатаДокумента", Дата);
	ЗапросОстатки.УстановитьПараметр("Ссылка", Ссылка);
	ЗапросОстатки.Текст =
	"ВЫБРАТЬ
	|	Bestaende.Komponenten КАК Komponente,
	|	СУММА(ВЫБОР
	|			КОГДА Bestaende.ВидДвижения = ЗНАЧЕНИЕ(ВидДвиженияНакопления.Расход)
	|				ТОГДА -Bestaende.Menge
	|			ИНАЧЕ Bestaende.Menge
	|		КОНЕЦ) КАК Bestand
	|ИЗ
	|	РегистрНакопления.Bestaende КАК Bestaende
	|ГДЕ
	|	Bestaende.Komponenten В (&Компоненты)
	|	И Bestaende.Активность = ИСТИНА
	|	И (Bestaende.Период < &ДатаДокумента
	|		ИЛИ (Bestaende.Период = &ДатаДокумента И Bestaende.Регистратор <> &Ссылка))
	|СГРУППИРОВАТЬ ПО
	|	Bestaende.Komponenten";
	
	ОстаткиПоКомпонентам = Новый Соответствие;
	ВыборкаОстатков = ЗапросОстатки.Выполнить().Выбрать();
	Пока ВыборкаОстатков.Следующий() Цикл
		ОстаткиПоКомпонентам[ВыборкаОстатков.Komponente] = ВыборкаОстатков.Bestand;
	КонецЦикла;
	
	Для Каждого КлючИЗначение Из СуммыПоКомпонентам Цикл
		
		Компонент = КлючИЗначение.Ключ;
		КоличествоВДокументе = КлючИЗначение.Значение;
		СведенияКомпонента = СведенияОКомпонентах.Получить(Компонент);
		
		ОстатокНаМомент = ОстаткиПоКомпонентам.Получить(Компонент);
		Если ОстатокНаМомент = Неопределено Тогда
			ОстатокНаМомент = 0;
		КонецЕсли;
		
		ОстатокПослеСписания = ОстатокНаМомент - КоличествоВДокументе;
		МинимальныйОстаток = СведенияКомпонента.Mindestbestand;
		
		Если ОстатокПослеСписания < МинимальныйОстаток Тогда
			
			Отказ = Истина;
			
			Представление = ?(ЗначениеЗаполнено(СведенияКомпонента.Artikel), СведенияКомпонента.Artikel, СведенияКомпонента.Name);
			Единица = СведенияКомпонента.Einheit;
			
			Сообщить("Bestand unter Mindestbestand: " + Представление + "." + Символы.ПС
				+ "Verfügbar nach Verbrauch: " + Формат(ОстатокПослеСписания, "ЧДЦ=3; ЧН=0") + " " + Единица + "." + Символы.ПС
				+ "Mindestbestand: " + Формат(МинимальныйОстаток, "ЧДЦ=3; ЧН=0") + " " + Единица + ".");
			
		КонецЕсли;
		
	КонецЦикла;
	
	Если Отказ Тогда
		Возврат;
	КонецЕсли;
	
	Движения.Bestaende.Записывать = Истина;
	
	Для Каждого КлючИЗначение Из СуммыПоКомпонентам Цикл
		Движение = Движения.Bestaende.Добавить();
		Движение.ВидДвижения = ВидДвиженияНакопления.Расход;
		Движение.Период = Дата;
		Движение.Komponenten = КлючИЗначение.Ключ;
		Движение.Menge = КлючИЗначение.Значение;
	КонецЦикла;
	
КонецПроцедуры