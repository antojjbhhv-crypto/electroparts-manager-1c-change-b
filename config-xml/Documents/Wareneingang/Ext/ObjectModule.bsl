Процедура ОбработкаПроведения(Отказ, РежимПроведения)
	
	ЕстьСтрокиТЧ = Компоненты.Количество() > 0;
	ЕстьШапка = ЗначениеЗаполнено(Komponenten) Или (Menge <> 0 И ЗначениеЗаполнено(Menge));
	
	Если ЕстьСтрокиТЧ И ЕстьШапка Тогда
		Отказ = Истина;
		Сообщить("Wareneingang: заполнены и табличная часть Компоненты, и реквизиты шапки Komponenten/Menge - источник движений неоднозначен.");
		Возврат;
	КонецЕсли;
	
	Если ЕстьСтрокиТЧ Тогда
		
		Для Каждого СтрокаТЧ Из Компоненты Цикл
			Если Не ЗначениеЗаполнено(СтрокаТЧ.Komponente) Тогда
				Отказ = Истина;
				Сообщить("Komponente fehlt. Zeile " + СтрокаТЧ.НомерСтроки);
			КонецЕсли;
			Если СтрокаТЧ.Menge <= 0 Тогда
				Отказ = Истина;
				Сообщить("Menge muss positiv sein. Zeile " + СтрокаТЧ.НомерСтроки);
			КонецЕсли;
		КонецЦикла;
		
		Если Отказ Тогда
			Возврат;
		КонецЕсли;
		
		Движения.Bestaende.Записывать = Истина;
		
		Для Каждого СтрокаТЧ Из Компоненты Цикл
			Движение = Движения.Bestaende.Добавить();
			Движение.ВидДвижения = ВидДвиженияНакопления.Приход;
			Движение.Период = Дата;
			Движение.Komponenten = СтрокаТЧ.Komponente;
			Движение.Menge = СтрокаТЧ.Menge;
		КонецЦикла;
		
		Возврат;
		
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(Komponenten) Тогда
		Отказ = Истина;
		Сообщить("Komponente fehlt.");
		Возврат;
	КонецЕсли;
	
	Если Menge <= 0 Тогда
		Отказ = Истина;
		Сообщить("Menge muss positiv sein.");
		Возврат;
	КонецЕсли;
	
	Движения.Bestaende.Записывать = Истина;
	
	Движение = Движения.Bestaende.Добавить();
	Движение.ВидДвижения = ВидДвиженияНакопления.Приход;
	Движение.Период = Дата;
	Движение.Komponenten = Komponenten;
	Движение.Menge = Menge;
	
КонецПроцедуры
