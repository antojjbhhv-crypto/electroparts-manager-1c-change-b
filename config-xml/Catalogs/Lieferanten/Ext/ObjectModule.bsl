Процедура ПередЗаписью(Отказ, РежимЗаписи, РежимПроведения)
	
	Если ПустаяСтрока(Наименование) Тогда
		Сообщить("Наименование поставщика не может быть пустым.");
		Отказ = Истина;
		Возврат;
	КонецЕсли;
	
	Если ПустаяСтрока(Kuerzel) Тогда
		Сообщить("Kuerzel не может быть пустым.");
		Отказ = Истина;
		Возврат;
	КонецЕсли;
	
	Если Lieferzeit < 0 Тогда
		Сообщить("Lieferzeit не может быть отрицательной.");
		Отказ = Истина;
		Возврат;
	КонецЕсли;
	
	Если Mindestbestellwert < 0 Тогда
		Сообщить("Mindestbestellwert не может быть отрицательным.");
		Отказ = Истина;
		Возврат;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	Поставщики.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.Lieferanten КАК Поставщики
	|ГДЕ
	|	ВРЕГ(Поставщики.Kuerzel) = ВРЕГ(&Куерцель)
	|	И Поставщики.Ссылка <> &ТекущаяСсылка";
	
	ТекущаяСсылка = Справочники.Lieferanten.ПустаяСсылка();
	Если ЗначениеЗаполнено(Ссылка) Тогда
		ТекущаяСсылка = Ссылка;
	КонецЕсли;
	
	Запрос.УстановитьПараметр("Куерцель", СокрЛП(Kuerzel));
	Запрос.УстановитьПараметр("ТекущаяСсылка", ТекущаяСсылка);
	
	Если Не Запрос.Выполнить().Пустой() Тогда
		Сообщить("Kuerzel bereits vergeben: " + СокрЛП(Kuerzel) + ". Kuerzel muss eindeutig sein.");
		Отказ = Истина;
	КонецЕсли;
	
КонецПроцедуры

Процедура ПередУдалением(Отказ)
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	Компоненты.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.Komponenten КАК Компоненты
	|ГДЕ
	|	Компоненты.Lieferant = &Поставщик";
	Запрос.УстановитьПараметр("Поставщик", Ссылка);
	
	Если Не Запрос.Выполнить().Пустой() Тогда
		Сообщить("Lieferant kann nicht gelöscht werden: es gibt verknüpfte Komponenten.");
		Отказ = Истина;
	КонецЕсли;
	
КонецПроцедуры
