Процедура ПриКомпоновкеРезультата(ДокументРезультат, ДанныеРасшифровки, СтандартнаяОбработка)

	СтандартнаяОбработка = Ложь;

	НаписатьШапку(ДокументРезультат);

	КомпоновщикМакета = Новый КомпоновщикМакетаКомпоновкиДанных;
	МакетКомпоновки = КомпоновщикМакета.Выполнить(
		СхемаКомпоновкиДанных,
		КомпоновщикНастроек.ПолучитьНастройки());

	ПроцессорКомпоновки = Новый ПроцессорКомпоновкиДанных;
	Если ТипЗнч(ДанныеРасшифровки) = Тип("ДанныеРасшифровкиКомпоновкиДанных") Тогда
		ПроцессорКомпоновки.Инициализировать(МакетКомпоновки, , ДанныеРасшифровки);
	Иначе
		ПроцессорКомпоновки.Инициализировать(МакетКомпоновки);
	КонецЕсли;

	ПроцессорВывода = Новый ПроцессорВыводаРезультатаКомпоновкиДанныхВТабличныйДокумент;
	ПроцессорВывода.УстановитьДокумент(ДокументРезультат);
	ПроцессорВывода.Вывести(ПроцессорКомпоновки);

	ОформитьРезультат(ДокументРезультат);

КонецПроцедуры

Процедура НаписатьШапку(ДокументРезультат)

	ОбластьШапки = ДокументРезультат.Область(1, 1);
	ОбластьШапки.Текст = "Stand: " + Формат(ТекущаяДата(), "ДЛФ=D");

	Попытка
		ОбластьШапки.Шрифт = Новый Шрифт(, 12, Истина);
	Исключение
	КонецПопытки;

КонецПроцедуры

Процедура ОформитьРезультат(ДокументРезультат)

	Ширины = Новый Массив;
	Ширины.Добавить(28);
	Ширины.Добавить(10);
	Ширины.Добавить(14);
	Ширины.Добавить(11);
	Ширины.Добавить(22);

	Для К = 1 По Ширины.Количество() Цикл
		Попытка
			ДокументРезультат.Область(1, К).ШиринаКолонки = Ширины[К - 1];
		Исключение
		КонецПопытки;
	КонецЦикла;

	Попытка
		ДокументРезультат.ОтображатьЗаголовки = Ложь;
	Исключение
	КонецПопытки;

	Попытка
		ДокументРезультат.ОтображатьСетку = Ложь;
	Исключение
	КонецПопытки;

	ЗаменитьИтоги(ДокументРезультат);

	Попытка
		ДокументРезультат.Защита = Истина;
	Исключение
	КонецПопытки;

КонецПроцедуры

Процедура ЗаменитьИтоги(ДокументРезультат)

	Для Н = 1 По ДокументРезультат.ВысотаТаблицы Цикл
		Если СокрЛП(ДокументРезультат.Область(Н, 1).Текст) = "Итого" Тогда
			ДокументРезультат.Область(Н, 1).Текст = "Gesamt";
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры
