&НаКлиенте
Процедура ВыполнитьКорректировку(Команда)
	ВыполнитьНаСервере();
КонецПроцедуры

&НаСервере
Процедура ВыполнитьНаСервере()
	Попытка
		СтрокаID = СокрЛП(OperationID);
		Если СтрокаID = "" Тогда
			ВызватьИсключение "Korrektur: не указан OperationID";
		КонецЕсли;
		Идентификатор = Новый УникальныйИдентификатор(СтрокаID);
		ОбработкаКорректировки = Обработки.Korrektur.Создать();
		Итог = ОбработкаКорректировки.ВыполнитьКорректировку(Идентификатор, Компонента, Изменение, Причина);
		Сообщить("Результат: " + Итог.Результат + ", документ: " + Строка(Итог.Документ));
	Исключение
		Сообщить("Ошибка: " + ОписаниеОшибки());
	КонецПопытки;
КонецПроцедуры
