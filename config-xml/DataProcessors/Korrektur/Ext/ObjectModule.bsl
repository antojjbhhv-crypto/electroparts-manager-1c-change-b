Функция ВыполнитьКорректировку(OperationID, Компонента, Изменение, Причина = "") Экспорт

	Если ТипЗнч(OperationID) <> Тип("УникальныйИдентификатор") Тогда
		ВызватьИсключение "Korrektur: OperationID должен быть UUID";
	КонецЕсли;
	Если НЕ ЗначениеЗаполнено(Компонента) Тогда
		ВызватьИсключение "Korrektur: не указана компонента";
	КонецЕсли;
	Если Изменение = 0 Тогда
		ВызватьИсключение "Korrektur: изменение не может быть нулевым";
	КонецЕсли;

	НачатьТранзакцию();
	Попытка
		Запись = РегистрыСведений.KorrekturJournal.СоздатьМенеджерЗаписи();
		Запись.OperationID = OperationID;
		Запись.Компонента = Компонента;
		Запись.Изменение = Изменение;
		Запись.ДатаКорректировки = ТекущаяДата();
		Запись.Пользователь = ИмяТекущегоПользователя();
		Запись.Причина = Причина;
		Запись.Результат = "Зарезервировано";
		Запись.Записать(Ложь);
	Исключение
		ОтменитьТранзакцию();
		Существующая = ПрочитатьЗапись(OperationID);
		Если Существующая = Неопределено Тогда
			ВызватьИсключение;
		КонецЕсли;
		Если Существующая.Компонента = Компонента И Существующая.Изменение = Изменение Тогда
			Возврат Новый Структура("Результат, Документ", Существующая.Результат, Существующая.Документ);
		КонецЕсли;
		ВызватьИсключение "Korrektur: OperationID уже использован с другим payload";
	КонецПопытки;

	Попытка
		ОстатокДо = ОстатокПоКомпоненте(Компонента);
		Минимум = Компонента.Mindestbestand;
		Если Минимум = NULL Тогда
			Минимум = 0;
		КонецЕсли;
		ОстатокПосле = ОстатокДо + Изменение;
		ДефицитДо = Макс(0, Минимум - ОстатокДо);
		ДефицитПосле = Макс(0, Минимум - ОстатокПосле);
		Если ДефицитПосле > ДефицитДо Тогда
			ВызватьИсключение "Korrektur: корректировка ухудшает дефицит";
		КонецЕсли;

		Если Изменение > 0 Тогда
			Документ = Документы.Wareneingang.СоздатьДокумент();
			Строка = Документ.Компоненты.Добавить();
		Иначе
			Документ = Документы.Verbrauch.СоздатьДокумент();
			Строка = Документ.Komponenten.Добавить();
		КонецЕсли;
		Документ.Дата = Запись.ДатаКорректировки;
		Строка.Komponente = Компонента;
		Строка.Menge = ?(Изменение > 0, Изменение, -Изменение);
		Документ.Записать(РежимЗаписиДокумента.Проведение);

		Запись.Результат = "Проведено";
		Запись.Документ = Документ.Ссылка;
		Запись.Записать();

		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		ВызватьИсключение;
	КонецПопытки;

	Возврат Новый Структура("Результат, Документ", Запись.Результат, Запись.Документ);

КонецФункции

Функция ПрочитатьЗапись(OperationID) Экспорт
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ ПЕРВЫЕ 1 Компонента, Изменение, Результат, Документ ИЗ РегистрСведений.KorrekturJournal ГДЕ OperationID = &OperationID";
	Запрос.УстановитьПараметр("OperationID", OperationID);
	Выборка = Запрос.Выполнить().Выбрать();
	Если НЕ Выборка.Следующий() Тогда
		Возврат Неопределено;
	КонецЕсли;
	Возврат Новый Структура("Компонента, Изменение, Результат, Документ", Выборка.Компонента, Выборка.Изменение, Выборка.Результат, Выборка.Документ);
КонецФункции

Функция ОстатокПоКомпоненте(Компонента) Экспорт
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ Остатки.Komponenten КАК Компонента, Остатки.MengeОстаток КАК Menge ИЗ РегистрНакопления.Bestaende.Остатки КАК Остатки ГДЕ Остатки.Komponenten = &Компонента";
	Запрос.УстановитьПараметр("Компонента", Компонента);
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Menge;
	КонецЕсли;
	Возврат 0;
КонецФункции

Функция ИмяТекущегоПользователя() Экспорт
	Имя = СокрЛП(ИмяПользователя());
	Если Имя <> "" Тогда
		Возврат Имя;
	КонецЕсли;
	Попытка
		Сеть = Новый COMОбъект("WScript.Network");
		Имя = СокрЛП(Сеть.UserName);
		Сеть = Неопределено;
	Исключение
		Имя = "";
	КонецПопытки;
	Если Имя <> "" Тогда
		Возврат Имя;
	КонецЕсли;
	Возврат "НеОпределён";
КонецФункции
